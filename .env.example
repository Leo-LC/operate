# Google OAuth (from Google Cloud Console — Capybara Google Review project)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# next-auth (required for OAuth sign-in; without it you get "ikm must be at least one byte")
NEXTAUTH_SECRET=    # REQUIRED. Generate: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000

# Optional sign-in whitelist (comma-separated list +/or domain)
# Examples:
# ALLOWED_GOOGLE_EMAILS=leo.lecee@gmail.com,leo@capybaracoffeethailand.com,bookings@capybaracoffeethailand.com
# ALLOWED_GOOGLE_DOMAIN=capybaracoffeethailand.com
ALLOWED_GOOGLE_EMAILS=
ALLOWED_GOOGLE_DOMAIN=

# Supabase (required for platform DB, admin features, documents, animals)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=   # service role key from Supabase dashboard → Settings → API
