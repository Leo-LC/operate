# Google OAuth (from Google Cloud Console — Capybara Google Review project)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# next-auth (required for OAuth sign-in; without it you get "ikm must be at least one byte")
NEXTAUTH_SECRET=    # REQUIRED. Generate: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000

# Sign-in whitelist (comma-separated list +/or domain)
# Examples:
# ALLOWED_GOOGLE_EMAILS=leo@example.com,bookings@example.com
# ALLOWED_GOOGLE_DOMAIN=example.com
ALLOWED_GOOGLE_EMAILS=
ALLOWED_GOOGLE_DOMAIN=

# Owner emails (fallback if ALLOWED_GOOGLE_EMAILS is not set)
# Users listed here get global_role=owner if not overridden by DB
OWNER_GOOGLE_EMAILS=

# Optional: pin to a specific Google Business account ID (skips account selection logic)
GOOGLE_BUSINESS_ACCOUNT_ID=

# Supabase (required for platform DB, admin features, documents, animals)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=   # service role key from Supabase dashboard → Settings → API

# Cron jobs (Vercel Cron / api/cron/*) — shared secret that Vercel sends as "Authorization: Bearer <CRON_SECRET>"
# REQUIRED for /api/cron/sheet-sync, /api/challenges/reviews/sync, /api/reports/daily-profit/sync.
# Generate: openssl rand -base64 32
CRON_SECRET=

# Loyverse API (owner-only sandbox — Personal Access Token from Back Office → Access Tokens)
LOYVERSE_ACCESS_TOKEN=
LOYVERSE_API_BASE=https://api.loyverse.com/v1.0

# Customer Insights — Google Form responses spreadsheet (uses org OAuth, same as accounting)
CUSTOMER_INSIGHTS_SHEET_ID=1658APEbKlP2zdpO3z0mH_T49RXCwIlOUGTDm6cLlUPA
CUSTOMER_INSIGHTS_SHEET_TAB=Form Responses 1
